{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev-browser",
  "description": "App commands exposed to the localhost-only debug invoke bridge.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://tauri.localhost/*"]
  },
  "permissions": [
    "allow-list-novel-sources",
    "allow-search-novels",
    "allow-get-novel-overview",
    "allow-get-chapter",
    "allow-prefetch-chapters",
    "allow-list-bookshelf",
    "allow-add-to-bookshelf",
    "allow-remove-from-bookshelf",
    "allow-get-reading-progress",
    "allow-save-reading-progress"
  ]
}
